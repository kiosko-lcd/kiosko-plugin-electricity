{
  "name": "kiosko-plugin-electricity",
  "version": "0.1.0",
  "description": "The electricity price by the hour on a small USB LCD panel: the price now against the rest of the day, the day's bars with tomorrow's, and the cheapest hours to run the washing machine. Today for Spain's PVPC, from Red Eléctrica, no key needed.",
  "type": "module",
  "license": "MIT",
  "author": "Loksly <info@kioskolcd.dev> (https://kioskolcd.dev)",
  "keywords": [
    "kiosko",
    "kiosko-plugin",
    "lcd",
    "widgets",
    "info",
    "electricity",
    "energy-prices",
    "pvpc",
    "ree",
    "spain",
    "precio-luz"
  ],
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-electricity#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiosko-lcd/kiosko-plugin-electricity.git"
  },
  "bugs": {
    "url": "https://github.com/kiosko-lcd/kiosko-plugin-electricity/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "kiosko": {
    "plugin": "./dist/index.js",
    "id": "electricity",
    "sdk": "^0.2.0",
    "languages": [
      "en",
      "es",
      "de",
      "zh-Hant",
      "zh-Hans"
    ],
    "manifest": "./kiosko-manifest.json"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "files": [
    "dist",
    "docs",
    "kiosko-manifest.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --conditions=source --test \"src/**/*.test.ts\"",
    "check": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@kiosko/sdk": "^0.2.0"
  },
  "devDependencies": {
    "@kiosko/core": "^0.2.11",
    "@kiosko/sdk": "^0.2.11",
    "@loksly/lcd-canvas-kit": "^0.2.0",
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
